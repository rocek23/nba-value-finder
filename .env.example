# Copia questo file in ".env" (stessa cartella) e compila i valori.
# Il file .env e' escluso da Git: non committarlo e non incollare mai le chiavi in chat.

# --- BALLDONTLIE (statistiche NBA; props solo piano GOAT) ---
BALLDONTLIE_API_KEY=
# Richieste al minuto consentite dal tuo piano (docs ufficiali: Free=5, ALL-STAR=60, GOAT=600)
BALLDONTLIE_REQUESTS_PER_MIN=60

# --- The Odds API (quote) ---
THE_ODDS_API_KEY=
# Regioni bookmaker da interrogare (ogni regione costa crediti). Esempio: eu,us
ODDS_REGIONS=eu,us

# --- nba_api (nessuna chiave richiesta) ---
# Pausa tra chiamate a stats.nba.com (limiti non documentati: resta prudente)
NBA_API_SLEEP_SECONDS=1.5

# --- Comportamento generale ---
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
# Oltre questa eta' una quota viene considerata obsoleta
MAX_QUOTE_AGE_MINUTES=30
