# Copia questo file in ".env" (stessa cartella) e compila i valori.
# Il file .env e' escluso da Git: non committarlo e non incollare mai le chiavi in chat.

# --- BALLDONTLIE (statistiche NBA; props solo piano GOAT) ---
BALLDONTLIE_API_KEY=
BALLDONTLIE_REQUESTS_PER_MIN=5

# --- The Odds API (quote) ---
THE_ODDS_API_KEY=
ODDS_REGIONS=eu,us

# --- nba_api (nessuna chiave richiesta) ---
NBA_API_SLEEP_SECONDS=1.5

# --- Comportamento generale ---
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
MAX_QUOTE_AGE_MINUTES=30
